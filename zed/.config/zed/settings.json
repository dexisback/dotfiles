{
  "autosave": "on_focus_change",
  "file_finder": {
    "include_ignored": "all"
  },
  "cli_default_open_behavior": "new_window",
  "proxy": "",

  "show_edit_predictions": true,

  "edit_predictions": {
    "provider": "zed",
    "mode": "subtle"
  },

  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },

  "icon_theme": "VSCode Icons",

  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "reasoning_effort": "low"
      },
      "type": "registry"
    },
    "gemini": {
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "fast": false
      },
      "type": "registry"
    }
  },

  "agent": {
    "auto_compact": {
      "threshold": "90%"
    },
    "play_sound_when_agent_done": "always",
    "inline_assistant_model": {
      "provider": "zed.dev",
      "model": "gpt-5-mini",
      "enable_thinking": false
    },
    "sandbox_permissions": {
      "network_hosts": [
        "registry.npmjs.org",
        "registry.yarnpkg.com",
        "registry.npmjs.cf"
      ]
    },
    "tool_permissions": {
      "tools": {
        "terminal": {
          "default": "allow"
        }
      }
    },
    "dock": "right",
    "default_model": {
      "effort": "medium",
      "provider": "zed.dev",
      "model": "claude-haiku-5-5",
      "enable_thinking": true
    },
    "favorite_models": [],
    "model_parameters": []
  },

  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Cursor Dark"
  },

  "ui_font_family": "Inter",
  "ui_font_size": 16,

  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 14,
  "buffer_line_height": "comfortable",
  "buffer_font_features": {
    "calt": false
  },
"horizontal_scroll_margin": 0,
"extend_comment_on_newline": false,
"close_panel_on_toggle": true,
}
