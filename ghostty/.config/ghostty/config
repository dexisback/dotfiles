# ==============================================================================
# Ghostty Terminal Configuration (Cross-Platform macOS + Linux)
# Managed via dotfiles: https://github.com/dexisback/dotfiles
# ==============================================================================

# Theme
theme = Catppuccin Mocha

# Cursor
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor
cursor-click-to-move = true

# Font
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 12
font-feature = calt
font-feature = liga

# Window
background-opacity = 1
macos-titlebar-style = native
window-show-tab-bar = auto
window-subtitle = false
window-padding-x = 2
window-padding-y = 2
window-padding-balance = false

# Behavior & Typing
macos-option-as-alt = true
confirm-close-surface = false
mouse-hide-while-typing = true
selection-clear-on-typing = true
copy-on-select = true
clipboard-paste-protection = true
scrollback-limit = 20000
working-directory = home
window-inherit-working-directory = false

# Keybindings: VS Code-style word deletion & typing productivity
keybind = ctrl+backspace=text:\x17
keybind = ctrl+delete=text:\x1bd
keybind = ctrl+f=start_search
keybind = ctrl+shift+f=start_search
keybind = ctrl+shift+s=search_selection
keybind = ctrl+shift+up=jump_to_prompt:-1
keybind = ctrl+shift+down=jump_to_prompt:1
