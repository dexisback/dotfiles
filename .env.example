# ==============================================================================
# Dotfiles Environment Secrets Template
# Copy this file to ~/.env (or ~/.zshrc.local) on your machine.
# DO NOT COMMIT YOUR REAL CREDENTIALS OR TOKENS TO GIT.
# ==============================================================================

# GitHub MCP / API Token
# Generate at https://github.com/settings/tokens
export GITHUB_MCP_TOKEN="ghp_your_github_token_here"

# Spotify API Credentials (e.g. for mufetch / terminal widgets)
# Generate at https://developer.spotify.com/dashboard
export SPOTIFY_CLIENT_ID="your_spotify_client_id_here"
export SPOTIFY_CLIENT_SECRET="your_spotify_client_secret_here"

# Add any additional machine-specific or secret environment variables below:
# export AWS_ACCESS_KEY_ID=""
# export AWS_SECRET_ACCESS_KEY=""
# export OPENAI_API_KEY=""
# export ANTHROPIC_API_KEY=""
